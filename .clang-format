BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never

BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterStruct: false
  AfterEnum: false
  AfterNamespace: false
  AfterFunction: false
  AfterControlStatement: Never
  BeforeElse: false
  BeforeCatch: false
  BeforeWhile: false